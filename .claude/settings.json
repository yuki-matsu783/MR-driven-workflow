{
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Bash(git commit*)",
      "PowerShell(git commit*)"
    ]
  },
  "plansDirectory": "./wip/plans",
  "autoCompactWindow": 600000,
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000",
    "OTEL_METRICS_INCLUDE_ENTRYPOINT": "true"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/otel/session-start.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-direct-git-commit.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-push-usage-report.sh"
            ],
            "timeout": 20
          },
          {
            "type": "command",
            "if": "PowerShell(git push*)",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-push-usage-report.sh"
            ],
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-push-compact-prompt.sh"
            ],
            "timeout": 20
          },
          {
            "type": "command",
            "if": "PowerShell(git push*)",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-push-compact-prompt.sh"
            ],
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__github__issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-issue-create-notice.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
